# The website this door answers for.
SITE_URL=https://harborgoods.example

# AI Gateway key: https://vercel.com/docs/ai-gateway
# Not needed on Vercel, where the deployment signs in to AI Gateway on its own.
AI_GATEWAY_API_KEY=

# Optional. The name in agent.txt. Defaults to the home page title.
SITE_NAME=
# Optional. The page where people chat with you.
CHAT_URL=
# Optional. The public origin of this door, when it differs from the request host.
PUBLIC_URL=

# Optional. Without it, the door tries Claude Sonnet, then models a free AI Gateway key can call.
CAP_MODEL=
# Model tokens per UTC day for the whole door, and messages per caller per day.
CAP_DAILY_TOKENS=500000
CAP_DAILY_LIMIT=50

# Optional. Postgres instead of the SQLite file in data/.
DATABASE_URL=
